# Copy to backend/.env and fill in.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override default models per provider
# GROQ_MODEL=openai/gpt-oss-120b
# REASONING_EFFORT=low   # low | medium | high (gpt-oss models)

# Other OpenAI-compatible providers (optional)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Default provider when the UI doesn't pick one: groq | openai | openrouter | ollama | mock
HIVEWRIGHT_PROVIDER=groq

# Max concurrent LLM calls per run (keep low on Groq free tier)
HIVEWRIGHT_MAX_PARALLEL=3
